java_library {
    name: "oplus-fwk",
    installable: true,

    srcs: [
        "src/**/*.aidl",
        "src/**/*.java",
    ],

    // Stub OPLUS framework API surface: expose methods to apps (OPlusCamera)
    // instead of hiddenapi-blocking them.
    libs: [
        "unsupportedappusage",
    ],
}
